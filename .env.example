# --- Nome exibido no site ---
NEXT_PUBLIC_NOME_CLINICA=Ayllus Nutrição

# --- Google Agenda ---
# Deixe em branco para rodar em modo de teste (agenda simulada em memória).
# Veja o passo a passo em docs/configurar-google-agenda.md
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# --- Supabase (contas, painel, dietas e vínculo das consultas) ---
# Settings > API no painel do Supabase. Em branco: o site público e o agendamento funcionam, a área de contas fica desligada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SEGREDO: ignora todas as regras de acesso. Só no servidor (Vercel > Environment Variables). Nunca commitar.
SUPABASE_SECRET_KEY=
